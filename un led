#define THINGER_SERIAL_DEBUG

#include <ThingerESP8266.h>

#define USERNAME "Mgaly_Arias"
#define DEVICE_ID "1ledAriaS"
#define DEVICE_CREDENTIAL "123456"

#define SSID "CasaMagalyWiFi"
#define SSID_PASSWORD "Magaly2026"

#define LED_PIN D2

ThingerESP8266 thing(USERNAME, DEVICE_ID, DEVICE_CREDENTIAL);

void setup() {
  Serial.begin(115200);
  pinMode(LED_PIN, OUTPUT);

  thing.add_wifi(SSID, SSID_PASSWORD);

  thing["led"] << [](pson &in){
    digitalWrite(LED_PIN, in ? HIGH : LOW);
  };
}

void loop() {
  thing.handle();
}
