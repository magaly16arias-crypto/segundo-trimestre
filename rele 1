#define LED1 8
#define LED2 9
#define RELE 7

void setup() {
  pinMode(LED1, OUTPUT);
  pinMode(LED2, OUTPUT);
  pinMode(RELE, OUTPUT);
}

void loop() {

  // Enciende LED1
  digitalWrite(LED1, HIGH);
  delay(1000);

  // Enciende LED2
  digitalWrite(LED2, HIGH);
  delay(1000);

  // Activa relé
  digitalWrite(RELE, HIGH);
  delay(2000);

  // Apaga todo
  digitalWrite(LED1, LOW);
  digitalWrite(LED2, LOW);
  digitalWrite(RELE, LOW);
  delay(2000);
}
